; Steered MD -- constant-velocity pulling of CD4 from gp120
; For PMF via umbrella sampling: this generates starting configs
integrator  = md
dt          = 0.002      ; 2 fs
nsteps      = 500000     ; 1 ns total pull
nstxout     = 0
nstxout-compressed = 500 ; save every 1 ps
nstenergy   = 500
nstlog      = 500

; Velocity generation (needed since .xtc has no velocities)
gen-vel     = yes
gen-temp    = 300
gen-seed    = -1

; Temperature coupling
tcoupl      = V-rescale
tc-grps     = Protein non-Protein
tau-t       = 0.1     0.1
ref-t       = 300     300

; Pressure coupling
pcoupl      = Parrinello-Rahman
pcoupltype  = isotropic
tau-p       = 2.0
ref-p       = 1.0
compressibility = 4.5e-5

; Electrostatics
coulombtype = PME
rcoulomb    = 1.0
rvdw        = 1.0
pme-order   = 4
fourierspacing = 0.12

; Constraints
constraints = h-bonds
constraint-algorithm = LINCS
lincs-iter  = 1
lincs-order = 4

; PBC
pbc         = xyz

; COM removal
nstcomm     = 100
comm-mode   = linear
comm-grps   = System

; Pull code
pull                 = yes
pull-ncoords         = 1
pull-ngroups         = 2
pull-group1-name     = gp120
pull-group2-name     = CD4
pull-coord1-type     = umbrella
pull-coord1-geometry = distance
pull-coord1-dim      = Y Y Y
pull-coord1-groups   = 1 2
pull-coord1-start    = yes
pull-coord1-rate     = 0.01     ; 0.01 nm/ps
pull-coord1-k        = 1000     ; kJ/mol/nm^2

; Pull coordinate output
pull-nstxout         = 50       ; write pull coord every 0.1 ps
pull-nstfout         = 50       ; write pull force every 0.1 ps
